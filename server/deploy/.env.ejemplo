DOMINIO=api.tudominio.com
DB_PASSWORD=cambia-esta-clave
# token:usuario separados por coma. Un token por dispositivo.
CAROBD_TOKENS=token-pantalla-largo:alberto,token-movil-largo:alberto
# Asistente de voz (opcional). Sin clave, POST /asistente/token responde 503.
# Va en env/api.env del VPS, nunca en el repo ni en el APK.
OPENAI_API_KEY=
CAROBD_ASISTENTE_MODELO=gpt-realtime-mini
CAROBD_ASISTENTE_VOZ=marin
# Tokens efímeros por usuario y por día (cada uno abre una conversación).
CAROBD_ASISTENTE_TOKENS_DIA=30
